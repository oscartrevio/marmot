#compdef mm marmot

_mo() {
  local -a commands global
  commands=(
    'clean:Remove caches, old builds, logs, and package/Docker leftovers'
    'status:Live system health dashboard'
    'analyze:Interactive disk explorer'
    'optimize:Updates, trim, swap reset, orphaned processes'
    'purge:Remove build artifacts from idle projects'
    'uninstall:Remove packages plus their leftovers'
    'history:Show what marmot has changed'
  )
  global=('(-n --dry-run)'{-n,--dry-run}'[preview only]' '--debug[verbose logs]')

  if (( CURRENT == 2 )); then
    _describe 'command' commands
    return
  fi
  case $words[2] in
    clean)     _arguments $global '--whitelist[edit protected paths]' ;;
    status)    _arguments '--once[single snapshot]' '--json[machine-readable]' '--agent[plain text for AI agents]' '--view[layout]:view:(compact full)' '--interval[refresh seconds]:seconds' ;;
    analyze|analyse) _files -/ ;;
    optimize)  _arguments $global ;;
    purge)     _arguments $global '(-y --yes)'{-y,--yes}'[unattended: remove stale artifacts only]' '--all[include recent projects (interactive)]' '--paths[edit project roots]' '--days[idle days]:days' '*:directory:_files -/' ;;
    uninstall) _arguments $global '*:package:' ;;
    history)   _arguments '--json[JSON output]' '--all[full log]' '(-l --limit)'{-l,--limit}'[entries]:count' ;;
  esac
}

_mo "$@"
