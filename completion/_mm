#compdef mm marmot

_mo() {
  local -a commands global
  commands=(
    'clean:Remove caches, old builds, logs, and package/Docker leftovers'
    'status:Live system health dashboard'
    'analyze:Interactive disk explorer'
    'optimize:Updates, trim, swap reset, orphaned processes'
    'purge:Remove build artifacts from idle projects'
    'uninstall:Remove packages plus their leftovers'
    'schedule:Run a safe cleanup on a timer'
    'history:Show what marmot has changed'
    'update:Update marmot from its git checkout'
  )
  global=('(-n --dry-run)'{-n,--dry-run}'[preview only]' '--debug[verbose logs]')

  if (( CURRENT == 2 )); then
    _describe 'command' commands
    return
  fi
  case $words[2] in
    clean)     _arguments $global '--whitelist[edit protected paths]' '--sessions[move agent sessions older than N days to the Trash]:days' ;;
    status)    _arguments '--once[single snapshot]' '--json[machine-readable]' '--agent[plain text for AI agents]' '--view[layout]:view:(compact full)' '--interval[refresh seconds]:seconds' ;;
    analyze|analyse) _arguments $global '--json[print the overview as JSON]' '*:directory:_files -/' ;;
    optimize)  _arguments $global ;;
    purge)     _arguments $global '(-y --yes)'{-y,--yes}'[unattended: remove stale artifacts only]' '--all[include recent projects (interactive)]' '--paths[edit project roots]' '--days[idle days]:days' '*:directory:_files -/' ;;
    uninstall) _arguments $global '(-l --list)'{-l,--list}'[list removable packages]' '(-a --all)'{-a,--all}'[also list shared libraries]' '*:package:' ;;
    history)   _arguments '--json[JSON output]' '--all[full log]' '(-l --limit)'{-l,--limit}'[entries]:count' ;;
    schedule)
      if (( CURRENT == 3 )); then
        local -a subs=('status:what is scheduled, the next and the last run' 'enable:turn the timer on'
          'disable:remove what enable created' 'run:run the scheduled cleanup now')
        _describe 'subcommand' subs
      else
        _arguments $global '(--daily --weekly)--daily[enable: run every day]' '(--daily --weekly)--weekly[enable: run every week]'
      fi ;;
    update)    _arguments $global '--check[only report; exit 10 when an update is available]' ;;
  esac
}

_mo "$@"
